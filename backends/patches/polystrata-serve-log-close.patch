+    def close(self) -> None:
+        """The server ends: release the shared log's handle (the config's "log" is opened for this object's life).
+        Without it the handle outlives the server and Windows refuses to remove the log's temporary directory."""
+        log, self.log = self.log, None
+        if log is not None:
+            with contextlib.suppress(OSError):
+                log.close()
